{
  "name": "workout-tracker-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:verify": "node scripts/migrate.js verify",
    "db:check-export": "node scripts/check-export-fields.js",
    "db:migrate:prod": "npx vercel env pull .env.production && DOTENV_CONFIG_PATH=.env.production node scripts/migrate.js && rm -f .env.production",
    "db:migrate:prod:verify": "npx vercel env pull .env.production && DOTENV_CONFIG_PATH=.env.production node scripts/migrate.js verify && rm -f .env.production",
    "db:setup": "npx tsx scripts/setup-db.ts",
    "test:server": "node --test --import tsx tests/server/**/*.test.ts",
    "generate:swift": "quicktype lib/types.ts -o WorkoutTracker/Services/APIModels.swift --lang swift --just-types"
  },
  "dependencies": {
    "@vercel/postgres": "^0.10.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vercel/node": "^3.0.0",
    "quicktype": "^23.2.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
